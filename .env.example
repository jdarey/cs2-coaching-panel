# CS2 Coaching Panel - Environment Variables
# Skopiuj to do .env.local dla lokalnego developmentu
# Na Vercel dodaj te same zmienne w Settings > Environment Variables

# ============================================
# DATABASE (Neon PostgreSQL - FREE tier: 0.5GB storage)
# ============================================
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# ============================================
# NEXTAUTH (Required)
# ============================================
# Wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"  # Na Vercel: https://twoja-domena.vercel.app

# ============================================
# OPTIONAL: Email (Resend - FREE: 100/dzień, 3000/mies.)
# ============================================
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="CS2 Coach <noreply@twoja-domena.com>"
# Bez zweryfikowanej domeny Resend wysyła tylko na adres właściciela konta.

# ============================================
# OPTIONAL: Email fallback SMTP (np. Gmail - FREE: 500/dzień)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="twoj@email.com"
# SMTP_PASS="haslo-aplikacji"

# ============================================
# OPTIONAL: File Storage (Vercel Blob - FREE: 1GB)
# ============================================
# BLOB_READ_WRITE_TOKEN="vercel_blob_xxx"

# ============================================
# OPTIONAL: Discord Webhook (dla powiadomień)
# ============================================
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx"

# ============================================
# OPTIONAL: Analytics (Vercel Analytics - FREE)
# ============================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ============================================
# COACH INVITE (osobiste zaproszenia trenerów)
# ============================================
# Tylko Ty znasz ten kod. Ktoś, komu go dasz, wpisuje go w rejestracji
# ("Mam kod trenera") i dostaje konto trenera. Bez kodu rejestracja
# zawsze zakłada konto ucznia. Wygeneruj np.: openssl rand -hex 16
# COACH_INVITE_CODE="twoj-tajny-kod"

# ============================================
# ADMIN (panel /admin: użytkownicy, treści maili)
# ============================================
# Jedyny admin. Przy logowaniu to konto zawsze dostaje rolę ADMIN.
# ADMIN_EMAIL="jdarey032@gmail.com"
# To samo dla przeglądarki (przycisk "Panel admina" w menu trenera):
# NEXT_PUBLIC_ADMIN_EMAIL="jdarey032@gmail.com"

# ============================================
# SECURITY
# ============================================
# Generuj losowe wartości dla produkcji
CSRF_SECRET=""
ENCRYPTION_KEY=""  # 32 znaki dla szyfrowania wrażliwych danych

# ============================================
# RATE LIMIT (Upstash Redis - FREE: 10k komend/dzień)
# ============================================
# Bez tych zmiennych działa fallback in-memory (OK lokalnie, słaby na Vercel
# z wieloma instancjami). Załóż darmowy Redis na upstash.com i wklej:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# CRON (Vercel Cron woła /api/cron/* z tym sekretem)
# ============================================
# Bez tego crony zwracają 401. Wygeneruj: openssl rand -hex 32
# CRON_SECRET=""

# ============================================
# STRONA I LINKI (logo w mailach, linki zwrotne)
# ============================================
# SITE_URL="https://twoja-domena.vercel.app"  # bez końcowego slasha
# YOUTUBE_URL="https://www.youtube.com/@TwojKanal"
# DISCORD_URL=""
# DISCORD_NAME="twoj-nick"

# ============================================
# OPTIONAL: klucze API gier (ulepszają Faceit/Steam, keyless działa bez nich)
# ============================================
# FACEIT_API_KEY=""
# STEAM_API_KEY=""
# YOUTUBE_API_KEY=""